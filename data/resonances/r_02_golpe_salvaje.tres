[gd_resource type="Resource" script_class="KarmanyResonanceData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/resonance_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/data/resonance_effect_block_data.gd" id="2_block"]
[ext_resource type="Script" path="res://scripts/data/karmany_effect_data.gd" id="3_effect"]

[sub_resource type="Resource" id="R02Discard"]
script = ExtResource("3_effect")
effect_type = 7
amount = 1
card_source_id = &"resonance"
description = "Despues del combate, descarta 1 carta de tu mano."

[sub_resource type="Resource" id="R02AfterCombat"]
script = ExtResource("2_block")
timing_id = &"after_combat"
effects = Array[ExtResource("3_effect")]([SubResource("R02Discard")])
description = "Penalizacion posterior al combate de Golpe Salvaje."

[resource]
script = ExtResource("1_data")
resonance_id = &"R-02"
display_name = "Golpe Salvaje"
resonance_type = 0
printed_power = 6
use_windows = PackedStringArray("combat")
effect_blocks = Array[ExtResource("2_block")]([SubResource("R02AfterCombat")])
rules_text = "Combate: +6 Poder. Despues del combate descarta 1 carta. Si tu Karmany no usa Riesgo, esta carta autoriza Dado de Riesgo 2.0."
tags = PackedStringArray("ataque", "combate", "risk_authorization")
