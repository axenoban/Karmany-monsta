[gd_resource type="Resource" script_class="KarmanyMissionData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/mission_data.gd" id="1_mission"]
[ext_resource type="Script" path="res://scripts/data/progress_condition_data.gd" id="2_cond"]
[ext_resource type="Script" path="res://scripts/data/karmany_effect_data.gd" id="3_effect"]

[sub_resource type="Resource" id="Condition_risk_wins_2"]
script = ExtResource("2_cond")
condition_type = 0
event_id = &"combat_won_with_risk"
threshold = 2
description = "Ganar 2 combates en los que se lanzo el Dado de Riesgo."

[sub_resource type="Resource" id="Reward_fa"]
script = ExtResource("3_effect")
effect_type = 1
amount = 1
resource_type = 3
description = "Mision completada: +1 FA."

[resource]
script = ExtResource("1_mission")
mission_id = &"ME-O1"
trainer_id = &"oryn"
trainer_display_name = "Oryn"
display_name = "Apuesta Victoriosa"
recommended_first_game = true
condition_text = "Gana 2 combates en los que hayas lanzado el Dado de Riesgo."
reward_legacy_points = 4
reward_effects = Array[ExtResource("3_effect")]([SubResource("Reward_fa")])
conditions = Array[ExtResource("2_cond")]([SubResource("Condition_risk_wins_2")])
